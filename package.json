{
  "name": "homestead-keep",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@homestead/web --filter=@homestead/api --filter=@homestead/worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=@homestead/api",
    "test:e2e": "playwright test",
    "db:generate": "yarn workspace @homestead/database generate",
    "db:migrate": "yarn workspace @homestead/database migrate:dev",
    "db:migrate:deploy": "yarn workspace @homestead/database migrate",
    "db:seed": "yarn workspace @homestead/database seed",
    "db:studio": "yarn workspace @homestead/database studio",
    "api:dev": "yarn workspace @homestead/api dev",
    "api:start": "yarn workspace @homestead/api start:prod",
    "worker:dev": "yarn workspace @homestead/worker dev",
    "worker:start": "yarn workspace @homestead/worker start",
    "web:dev": "yarn workspace @homestead/web dev",
    "web:start": "yarn workspace @homestead/web start",
    "web:build": "yarn workspace @homestead/web build",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "infra:ps": "docker compose -f infrastructure/docker-compose.yml ps"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "dotenv": "^18.0.2",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "turbo": "^2.5.4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22"
}
