{
  "name": "homestead-keep",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "yarn workspace @homestead/database generate",
    "db:migrate": "yarn workspace @homestead/database migrate:dev",
    "db:migrate:deploy": "yarn workspace @homestead/database migrate",
    "db:seed": "yarn workspace @homestead/database seed",
    "db:studio": "yarn workspace @homestead/database studio",
    "api:dev": "yarn workspace @homestead/api dev",
    "api:start": "yarn workspace @homestead/api start:prod",
    "worker:dev": "yarn workspace @homestead/worker dev",
    "worker:start": "yarn workspace @homestead/worker start",
    "web:dev": "yarn workspace @homestead/web dev",
    "web:start": "yarn workspace @homestead/web start",
    "web:build": "yarn workspace @homestead/web build",
    "legacy:dev": "next dev -p 3005",
    "legacy:build": "yarn db:generate && next build",
    "legacy:start": "next start -p 3005",
    "legacy:worker": "tsx src/workers/reminder-worker.ts",
    "legacy:lint": "eslint src tests --max-warnings 0",
    "legacy:typecheck": "tsc --noEmit",
    "legacy:test": "vitest run",
    "legacy:test:unit": "vitest run tests/unit",
    "legacy:test:integration": "vitest run tests/integration",
    "legacy:test:e2e": "playwright test"
  },
  "dependencies": {
    "@homestead/database": "0.1.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "minio": "^8.0.7",
    "next": "16.3.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^18.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "turbo": "^2.5.4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22"
}
