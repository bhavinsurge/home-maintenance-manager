{
  "name": "@homestead/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Homestead Keep reminder worker (non-HTTP)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node ../../scripts/run-with-env.js tsx watch src/index.ts",
    "start": "node ../../scripts/run-with-env.js node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@homestead/database": "0.1.0",
    "date-fns": "^4.4.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
