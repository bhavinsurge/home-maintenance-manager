generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HouseholdRole {
  OWNER
  MANAGER
  MEMBER
}

enum AssetCategory {
  APPLIANCE
  VEHICLE
  HVAC
  ELECTRONICS
  OUTDOOR
  OTHER
}

enum AssetStatus {
  ACTIVE
  RETIRED
  DISPOSED
}

enum ScheduleFrequency {
  ONCE
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM_DAYS
}

enum NotificationType {
  MAINTENANCE_DUE
  WARRANTY_EXPIRING
  SYSTEM
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens     RefreshToken[]
  memberships       HouseholdMember[]
  createdHouseholds Household[]       @relation("HouseholdCreator")
  createdAssets     Asset[]           @relation("AssetCreator")
  serviceRecords    ServiceRecord[]   @relation("ServiceRecordCreator")
  documents         Document[]        @relation("DocumentUploader")
  notifications     Notification[]
  auditLogs         AuditLog[]        @relation("AuditActor")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Household {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  addressLine1 String?  @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String?
  region       String?
  postalCode   String?  @map("postal_code")
  country      String?
  notes        String?
  createdById  String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy     User              @relation("HouseholdCreator", fields: [createdById], references: [id])
  members       HouseholdMember[]
  assets        Asset[]
  documents     Document[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([createdById])
  @@map("households")
}

model HouseholdMember {
  id          String        @id @default(uuid()) @db.Uuid
  householdId String        @map("household_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        HouseholdRole
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
  @@index([householdId, role])
  @@map("household_members")
}

model Asset {
  id            String        @id @default(uuid()) @db.Uuid
  householdId   String        @map("household_id") @db.Uuid
  name          String
  category      AssetCategory
  status        AssetStatus   @default(ACTIVE)
  manufacturer  String?
  model         String?
  serialNumber  String?       @map("serial_number")
  purchaseDate  DateTime?     @map("purchase_date") @db.Date
  purchasePrice Decimal?      @map("purchase_price") @db.Decimal(12, 2)
  locationNotes String?       @map("location_notes")
  notes         String?
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdById   String        @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  household      Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy      User                  @relation("AssetCreator", fields: [createdById], references: [id])
  schedules      MaintenanceSchedule[]
  serviceRecords ServiceRecord[]
  warranties     Warranty[]
  documents      Document[]

  @@index([householdId, deletedAt, status])
  @@index([householdId, name])
  @@map("assets")
}

model MaintenanceSchedule {
  id                 String            @id @default(uuid()) @db.Uuid
  assetId            String            @map("asset_id") @db.Uuid
  title              String
  description        String?
  frequency          ScheduleFrequency
  intervalDays       Int?              @map("interval_days")
  nextDueAt          DateTime          @map("next_due_at") @db.Timestamptz(3)
  lastCompletedAt    DateTime?         @map("last_completed_at") @db.Timestamptz(3)
  isActive           Boolean           @default(true) @map("is_active")
  reminderDaysBefore Int               @default(7) @map("reminder_days_before")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  asset              Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  serviceRecords     ServiceRecord[]
  reminderDispatches ReminderDispatch[]

  @@index([assetId])
  @@index([nextDueAt, isActive])
  @@map("maintenance_schedules")
}

model ServiceRecord {
  id          String   @id @default(uuid()) @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  scheduleId  String?  @map("schedule_id") @db.Uuid
  title       String
  performedAt DateTime @map("performed_at") @db.Timestamptz(3)
  cost        Decimal? @db.Decimal(12, 2)
  vendor      String?
  notes       String?
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  asset     Asset                @relation(fields: [assetId], references: [id], onDelete: Cascade)
  schedule  MaintenanceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  createdBy User                 @relation("ServiceRecordCreator", fields: [createdById], references: [id])
  documents Document[]

  @@index([assetId, performedAt(sort: Desc)])
  @@index([scheduleId])
  @@map("service_records")
}

model Warranty {
  id            String   @id @default(uuid()) @db.Uuid
  assetId       String   @map("asset_id") @db.Uuid
  provider      String
  coverageNotes String?  @map("coverage_notes")
  startsOn      DateTime @map("starts_on") @db.Date
  endsOn        DateTime @map("ends_on") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  asset              Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reminderDispatches ReminderDispatch[]

  @@index([assetId])
  @@index([endsOn])
  @@map("warranties")
}

model Document {
  id              String    @id @default(uuid()) @db.Uuid
  householdId     String    @map("household_id") @db.Uuid
  assetId         String?   @map("asset_id") @db.Uuid
  serviceRecordId String?   @map("service_record_id") @db.Uuid
  fileName        String    @map("file_name")
  contentType     String    @map("content_type")
  sizeBytes       Int       @map("size_bytes")
  storageKey      String    @unique @map("storage_key")
  uploadedById    String    @map("uploaded_by") @db.Uuid
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  household     Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  asset         Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  serviceRecord ServiceRecord? @relation(fields: [serviceRecordId], references: [id], onDelete: SetNull)
  uploadedBy    User          @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([assetId, deletedAt])
  @@index([householdId, deletedAt])
  @@map("documents")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  householdId String           @map("household_id") @db.Uuid
  type        NotificationType
  title       String
  body        String
  linkPath    String?          @map("link_path")
  readAt      DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([householdId])
  @@map("notifications")
}

model ReminderDispatch {
  id             String   @id @default(uuid()) @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key")
  scheduleId     String?  @map("schedule_id") @db.Uuid
  warrantyId     String?  @map("warranty_id") @db.Uuid
  dispatchedAt   DateTime @default(now()) @map("dispatched_at") @db.Timestamptz(3)

  schedule MaintenanceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  warranty Warranty?            @relation(fields: [warrantyId], references: [id], onDelete: Cascade)

  @@map("reminder_dispatches")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  householdId String?  @map("household_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  household Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  actor     User?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
