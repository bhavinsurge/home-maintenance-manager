# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3005

# PostgreSQL (Docker maps host 5434 → container 5432)
# Required. Local Docker default shown below.
# NOTE: Port 5434 avoids conflict with other local Postgres instances.
DATABASE_URL=postgresql://hmm:hmm_dev_password@localhost:5434/home_maintenance?schema=public

# Test database (integration tests)
# Required for integration tests only.
DATABASE_URL_TEST=postgresql://hmm:hmm_dev_password@localhost:5434/home_maintenance_test?schema=public

# JWT secrets — use long random strings in any shared environment
# Required.
JWT_ACCESS_SECRET=dev-access-secret-change-me-to-a-long-random-string
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Redis — optional for core CRUD; used for rate limiting + short dashboard cache
# Optional. App falls back to in-memory rate limiting if unreachable.
# NOTE: Port 6380 avoids conflict with other local Redis instances.
REDIS_URL=redis://localhost:6380

# MinIO / S3-compatible object storage
# Required for document uploads.
# NOTE: Ports 9010/9011 avoid conflict with ClickHouse and other services on 9000.
MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=home-maintenance

# Optional storage driver override: "local" forces filesystem uploads under .data/uploads
# When MinIO is unreachable, the app automatically falls back to local storage.
# STORAGE_DRIVER=local
# MINIO_DISABLED=true

# Worker
# Optional. Seconds between reminder scans (default 60).
REMINDER_POLL_INTERVAL_SECONDS=60
REMINDER_LEAD_DAYS=7

# Cookies
# Optional. Set true behind HTTPS.
COOKIE_SECURE=false
